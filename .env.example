APP_NAME=Huiyan Fraud Platform
APP_ENV=development
API_PREFIX=/api/v1

# Local quick start uses SQLite if DATABASE_URL is not set.
# MySQL example:
# DATABASE_URL=mysql+pymysql://huiyan:change-me@127.0.0.1:3306/huiyan
DATABASE_URL=sqlite:///./huiyan.db

REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM enhancement. Leave disabled for offline demo.
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=8
